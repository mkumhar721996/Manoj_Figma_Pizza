{
  "color-fg": {
    "$type": "color",
    "$description": "Primary body text color. Espresso brown, ~15.7:1 contrast on color-bg.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.16863, 0.10588, 0.07059],
      "hex": "#2b1b12"
    }
  },
  "color-fg-muted": {
    "$type": "color",
    "$description": "Secondary/supporting text color.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.41961, 0.33333, 0.27451],
      "hex": "#6b5546"
    }
  },
  "color-bg": {
    "$type": "color",
    "$description": "Page background. Warm cream.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 0.97255, 0.94118],
      "hex": "#fff8f0"
    }
  },
  "color-surface": {
    "$type": "color",
    "$description": "Raised surface background for cards and inputs.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Brand tomato-red, used for primary actions.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.75686, 0.15294, 0.17647],
      "hex": "#c1272d"
    }
  },
  "color-primary-hover": {
    "$type": "color",
    "$description": "Hover/active state for primary actions.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.61961, 0.12157, 0.14118],
      "hex": "#9e1f24"
    }
  },
  "color-primary-fg": {
    "$type": "color",
    "$description": "Text/icon color on top of color-primary.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-secondary": {
    "$type": "color",
    "$description": "Basil-green accent for secondary emphasis.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.16863, 0.41569, 0.3098],
      "hex": "#2b6a4f"
    }
  },
  "color-secondary-fg": {
    "$type": "color",
    "$description": "Text/icon color on top of color-secondary.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-accent": {
    "$type": "color",
    "$description": "Cheese-yellow accent for chips and highlights.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.94902, 0.64706, 0.2549],
      "hex": "#f2a541"
    }
  },
  "color-accent-fg": {
    "$type": "color",
    "$description": "Text/icon color on top of color-accent.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.23922, 0.16863, 0.05882],
      "hex": "#3d2b0f"
    }
  },
  "color-border": {
    "$type": "color",
    "$description": "Default hairline border color.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.87843, 0.82745, 0.76078],
      "hex": "#e0d3c2"
    }
  },
  "color-border-strong": {
    "$type": "color",
    "$description": "Emphasized border color, e.g. for focus/hover outlines.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.78824, 0.72157, 0.62745],
      "hex": "#c9b8a0"
    }
  },
  "color-shadow": {
    "$type": "color",
    "$description": "Base tint used to build elevation shadows.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0, 0, 0],
      "alpha": 0.16,
      "hex": "#000000"
    }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Smallest spacing step, used for tight gaps.",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$description": "Compact padding/gap step.",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$description": "Default padding/gap step.",
    "$value": { "value": 16, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$description": "Generous padding/gap step.",
    "$value": { "value": 24, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Corner radius for small controls (inputs, chips edges).",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Corner radius for buttons and cards.",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Corner radius for large surfaces and pill-shaped chips.",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$description": "Small text size, e.g. captions and chips.",
    "$value": { "value": 14, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$description": "Body text size.",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$description": "Heading/emphasis text size.",
    "$value": { "value": 20, "unit": "px" }
  },
  "border-width-sm": {
    "$type": "dimension",
    "$description": "Hairline border width.",
    "$value": { "value": 1, "unit": "px" }
  },
  "border-width-md": {
    "$type": "dimension",
    "$description": "Emphasized border width, e.g. secondary button outline.",
    "$value": { "value": 2, "unit": "px" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$description": "Default UI typeface stack.",
    "$value": "'Inter', 'Helvetica Neue', Arial, sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "line-height-base": {
    "$type": "number",
    "$description": "Unitless line-height for body copy.",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$description": "Subtle elevation for resting cards and inputs.",
    "$value": {
      "color": "{color-shadow}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 2, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "shadow-md": {
    "$type": "shadow",
    "$description": "Elevation for hovered/raised surfaces.",
    "$value": {
      "color": "{color-shadow}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 8, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "border-default": {
    "$type": "border",
    "$description": "Default hairline border used on cards and inputs.",
    "$value": {
      "color": "{color-border}",
      "width": "{border-width-sm}",
      "style": "solid"
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$description": "Alias: primary button background.",
    "$value": "{color-primary}"
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$description": "Alias: primary button hover background.",
    "$value": "{color-primary-hover}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$description": "Alias: primary button text/icon color.",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$description": "Alias: primary button corner radius.",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$description": "Alias: secondary button background.",
    "$value": "{color-surface}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$description": "Alias: secondary button text/icon color.",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$description": "Alias: secondary button border color.",
    "$value": "{color-primary}"
  },
  "card-default-background": {
    "$type": "color",
    "$description": "Alias: card background.",
    "$value": "{color-surface}"
  },
  "card-default-border": {
    "$type": "color",
    "$description": "Alias: card border color.",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$description": "Alias: card corner radius.",
    "$value": "{radius-md}"
  },
  "chip-default-background": {
    "$type": "color",
    "$description": "Alias: chip background.",
    "$value": "{color-accent}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$description": "Alias: chip text color.",
    "$value": "{color-accent-fg}"
  },
  "chip-default-radius": {
    "$type": "dimension",
    "$description": "Alias: chip corner radius (pill-like).",
    "$value": "{radius-lg}"
  },
  "input-default-background": {
    "$type": "color",
    "$description": "Alias: form control background.",
    "$value": "{color-surface}"
  },
  "input-default-border": {
    "$type": "color",
    "$description": "Alias: form control border color.",
    "$value": "{color-border}"
  },
  "input-default-foreground": {
    "$type": "color",
    "$description": "Alias: form control text color.",
    "$value": "{color-fg}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$description": "Alias: form control corner radius.",
    "$value": "{radius-sm}"
  }
}
